# Credenciales solo para desarrollo local con Docker Compose.
# Deben coincidir con el usuario creado en database/init.sql.
DB_USERNAME=marketroad_app
DB_PASSWORD=marketroad_local_dev
MYSQL_ROOT_PASSWORD=rootpassword
# Superusuario predeterminado (se crea al iniciar user-api si no existe).
# La contraseña debe tener 8-32 caracteres, con al menos una letra y un número. Cámbiala fuera de desarrollo local.
SUPERUSUARIO_CORREO=admin@marketroad.local
SUPERUSUARIO_CONTRASENA=Admin12345
# Soporte: secreto propio del personal (mín. 32 caracteres, distinto de JWT_SECRET) y administrador inicial del panel.
# La contraseña debe tener 8-32 caracteres, con al menos una letra y un número. Cámbiala fuera de desarrollo local.
SOPORTE_JWT_SECRET=cambia-el-secreto-del-personal-de-soporte-minimo-32
SOPORTE_ADMIN_CORREO=soporte-admin@marketroad.local
SOPORTE_ADMIN_CONTRASENA=Soporte12345
# Base de datos PROPIA de soporte (servidor MySQL aparte: servicio mysql-soporte). Cambia estas credenciales fuera de desarrollo local.
SOPORTE_MYSQL_ROOT_PASSWORD=rootpassword_soporte
SOPORTE_DB_USERNAME=soporte_app
SOPORTE_DB_PASSWORD=soporte_local_dev
# Cuenta inicial con rol SOPORTE (atiende tickets en soporte-panel.html). Misma política de contraseña que el administrador.
SOPORTE_AGENTE_CORREO=soporte@marketroad.local
SOPORTE_AGENTE_CONTRASENA=Agente12345
