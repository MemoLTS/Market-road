{
  "name": "market-road-frontend-react",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Frontend de Market-Road en React + TypeScript + Bootstrap, con pruebas unitarias Jasmine y Karma.",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs --single-run",
    "test:watch": "karma start karma.conf.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@types/jasmine": "^5.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webpack-env": "^1.18.5",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "webpack": "^5.99.0"
  }
}
