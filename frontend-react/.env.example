# Direcciones de la API en desarrollo (npm run dev)
#
# Opción 1 (recomendada, no hace falta crear .env): no definir VITE_API_URL.
#   La app llama a /api/v1 en el propio servidor de Vite y este lo reenvía al gateway (proxy).
#   El gateway se toma de VITE_GATEWAY_URL (por defecto http://localhost:8081).
VITE_GATEWAY_URL=http://localhost:8081
#
# Opción 2: llamar directamente a una URL completa (el gateway debe permitir CORS, y lo permite).
# VITE_API_URL=http://localhost:8081/api/v1
#
# true = usar la base de datos simulada (src/data/baseDatos.ts) en vez del backend
VITE_USAR_MOCK=false
