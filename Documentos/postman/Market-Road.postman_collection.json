              ]
            },
            "description": ""
          }
        },
        {
          "name": "Marcar vendida (vendedor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversaciones/{{conversacionId}}/venta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversaciones",
