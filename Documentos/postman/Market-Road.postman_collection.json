            "description": "Pone la publicación en VENDIDA, con comprador, precio y fecha de venta."
          }
        }
      ]
    },
    {
      "name": "4. Administración / Dashboard",
      "item": [
        {
          "name": "Resumen: nuevas y cerradas en ventas (7 días)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/publicaciones/resumen?dias=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "publicaciones",
                "resumen"
              ],
              "query": [
                {
                  "key": "dias",
                  "value": "7"
                }
              ]
            },
            "description": "Solo SUPERUSUARIO. dias entre 1 y 365 (1 = últimas 24 h)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y campos del resumen', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j).to.have.property('nuevas'); pm.expect(j).to.have.property('cerradasVentas'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Resumen (30 días)",
          "request": {
