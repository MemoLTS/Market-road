              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversaciones"
              ]
            },
            "description": "Usa otra cuenta distinta a la del vendedor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicacionId\": \"{{publicacionId}}\",\n  \"contenido\": \"Hola, ¿sigue disponible?\"\n}"
            }
          }
        },
        {
          "name": "Mis conversaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
